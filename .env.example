# ──────────────────────────────────────────────────────────────────────────
# Production env var reference for Coolify.
#
# Each app is deployed as its OWN Coolify resource (see docs/COOLIFY.md), so
# these are set on each resource's "Environment Variables" page — there is no
# shared .env file in production. This file only documents what goes where.
# ──────────────────────────────────────────────────────────────────────────

# ── Coolify PostgreSQL database resource (one-click) ──────────────────────
#   PostgreSQL Database (init db): research_agent
#   After deploy, copy the "Internal URL" from the database page and use it
#   as DATABASE_URL below (append ?schema=public).

# ── api resource (Dockerfile: apps/api/Dockerfile, port 3001) ─────────────
PORT=3001
DATABASE_URL=postgresql://<user>:<password>@<postgres-container>:5432/research_agent?schema=public
CORS_ORIGIN=https://ui.celeboty.com
TEMPORAL_ADDRESS=temporal-<temporal-stack-uuid>:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=research-agent

# ── worker resource (Dockerfile: apps/worker/Dockerfile, no port) ─────────
# DATABASE_URL=          (same as api)
# TEMPORAL_ADDRESS=      (same as api)
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=research-agent
# OPENCODE_API_KEY=      (required)
# TAVILY_API_KEY=        (required)

# ── web resource (Dockerfile: apps/web/Dockerfile, port 3000) ─────────────
# NEXT_PUBLIC_API_URL=https://api.celeboty.com
#   ^ baked into the client bundle at BUILD time (Coolify passes env vars to
#   the Dockerfile as build args by default) — set it before the first
#   deploy and redeploy web whenever it changes.

# ── temporal stack (docker-compose.temporal.yml) ──────────────────────────
# TEMPORAL_POSTGRES_PASSWORD=   (optional; default "temporal", internal-only)
# Domain for the temporal-ui service -> https://temporal.celeboty.com:8080
