# ──────────────────────────────────────────────────────────────────────────
# Production environment for the Coolify Docker Compose stack.
# Set these in the Coolify resource under "Environment Variables".
# Each ${VAR} in docker-compose.yml becomes an editable field there.
# ──────────────────────────────────────────────────────────────────────────

# Public URL of the API (no port — Coolify serves on 80/443 and routes to the
# container port). This is baked into the web (Next.js) client bundle at build
# time, so it must be set before the first deploy.
NEXT_PUBLIC_API_URL=http://api.celeboty.com

# Origin the API allows via CORS = the public URL of the web frontend (no port).
CORS_ORIGIN=http://ui.celeboty.com

# LLM + web-search keys used by the worker (required — stack will not start without them)
OPENCODE_API_KEY=
TAVILY_API_KEY=

# Temporal (optional — defaults shown)
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=research-agent

# NOTE — you do NOT set these manually; Coolify auto-generates them:
#   SERVICE_USER_POSTGRES         (random postgres username)
#   SERVICE_PASSWORD_64_POSTGRES  (random postgres password)
# DATABASE_URL is built in docker-compose.yml from the generated postgres credentials.
#
# Domains are NOT env vars — set them in each service's "Domains" field in Coolify:
#   web          -> http://ui.celeboty.com:3000
#   api          -> http://api.celeboty.com:3001
#   temporal-ui  -> http://temporal.celeboty.com:8080
# (the :port tells Coolify which container port to route to; the public URL is port 80/443)