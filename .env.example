# ──────────────────────────────────────────────────────────────────────────
# Production environment for the Coolify Docker Compose stack.
# Set these once in the Coolify resource under "Environment Variables".
# Every ${VAR} in docker-compose.yml becomes an editable field there, and a
# value set once is shared by all services that reference it.
# ──────────────────────────────────────────────────────────────────────────

# LLM + web-search keys used by the worker (required — stack will not start without them)
OPENCODE_API_KEY=
TAVILY_API_KEY=

# Public URL of the API, baked into the web (Next.js) client bundle at build time.
# Leave unset to auto-use the domain Coolify generates for the `api` service.
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Origin the API allows via CORS. Leave unset to auto-use the generated `web` domain.
# CORS_ORIGIN=https://your-domain.com

# Temporal (optional — defaults shown)
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# NOTE — you do NOT set these manually; Coolify auto-generates them:
#   SERVICE_USER_POSTGRES         (random postgres username)
#   SERVICE_PASSWORD_64_POSTGRES  (random postgres password)
#   SERVICE_URL_WEB_3000          (generated web domain)
#   SERVICE_URL_API_3001          (generated api domain)
# DATABASE_URL is built in docker-compose.yml from the generated postgres credentials.